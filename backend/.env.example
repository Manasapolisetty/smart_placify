# ==============================================================================
# SmartPlacify Backend Environment Variables Template
# Copy this file to '.env' and fill in the values for your deployment environment.
# DO NOT commit real secrets, credentials, or production passwords to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Option A: Cloud Database URI - Neon, Supabase, Render, Railway, AWS)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Database Configuration (Option B: Individual parameters for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartplacify_db
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD
DB_SSL=true

# Security & Authentication (JWT)
JWT_SECRET=YOUR_REALLY_STRONG_256_BIT_SECRET_KEY_HERE
JWT_EXPIRES_IN=1d

# CORS Configuration (Allowed Frontend Origins - comma-separated list supported)
CORS_ORIGIN=https://smartplacify.vercel.app,http://localhost:5173
# CLIENT_URL is supported as an alias for CORS_ORIGIN

