# ==============================================================================
# SmartPlacify Backend Environment Variables Template
# Copy this file to '.env' and fill in the values for your deployment environment.
# DO NOT commit real secrets, credentials, or production passwords to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartplacify_db
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD

# Security & Authentication (JWT)
JWT_SECRET=YOUR_REALLY_STRONG_256_BIT_SECRET_KEY_HERE
JWT_EXPIRES_IN=1d

# CORS Configuration (Allowed Frontend Origin)
CLIENT_URL=http://localhost:5173
